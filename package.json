{
  "name": "vocabulary-app",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build && node scripts/stamp-sw.mjs",
    "build:test": "tsc --noEmit && vite build --mode testhooks && node scripts/stamp-sw.mjs --dir=dist-test",
    "start": "node server.mjs",
    "start:test": "node server.mjs --dir=dist-test --port=4174",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "5.4.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "22.13.1",
    "fake-indexeddb": "6.0.0",
    "fast-check": "4.10.2",
    "jsdom": "^26.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
